{#
  Machine config of every node. scripts/talos-render.sh renders it with the node's entry from
  nodes.yaml and the secrets bundle, decrypted into a pipe and never written to disk.

  Nothing here is generated. talhelper built it from the Talos library it embedded, and a
  generator's library decides the shape of the config as much as talosVersion does: a newer
  one emits new documents on its own, and that is how KubeEtcdEncryptionConfig arrived with
  the apiserver outage. `talosctl gen config` output is still worth reading as the reference
  for what Talos now expects, but a new document enters this file by hand, in a diff.
#}
{% set this = (nodes | selectattr("hostname", "eq", node) | list)[0] %}
{% set cp = this.controlPlane %}
version: v1alpha1
debug: false
persist: true
machine:
  type: {{ "controlplane" if cp else "worker" }}
  token: {{ trustdinfo.token }}
  ca:
    crt: {{ certs.os.crt }}
    key: {{ certs.os.key if cp else '""' }}
  certSANs:
    - 10.0.20.10
    - 10.0.20.11
    - 10.0.20.12
    - 10.0.20.13
    - 10.0.20.14
    - 10.0.20.15
    - 10.0.20.16
  kubelet:
    image: ghcr.io/siderolabs/kubelet:{{ kubernetesVersion }}
    extraArgs:
      rotate-server-certificates: "true"
    extraMounts:
      - destination: /var/lib/longhorn
        type: bind
        source: /var/lib/longhorn
        options:
          - bind
          - rshared
          - rw
{% if not cp %}
      - destination: /var/mnt/longhorn
        type: bind
        source: /var/mnt/longhorn
        options:
          - bind
          - rshared
          - rw
{% endif %}
    extraConfig:
      serializeImagePulls: false
    defaultRuntimeSeccompProfileEnabled: true
    disableManifestsDirectory: true
  network:
    extraHostEntries:
      - ip: 10.0.20.20
        aliases:
          - zot.merry.home.arpa
  install:
    diskSelector:
      model: {{ this.installDisk }}
    image: factory.talos.dev/metal-installer/{{ schematic }}:{{ talosVersion }}
    wipe: false
    grubUseUKICmdline: true
  files:
    - content: |-
        [plugins."io.containerd.cri.v1.images"]
          discard_unpacked_layers = false
      permissions: 0o0
      path: /etc/cri/conf.d/20-customization.part
      op: create
