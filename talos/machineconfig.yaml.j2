      op: append
{% if not cp %}
  sysctls:
    net.ipv6.conf.enp1s0.accept_ra_rt_info_max_plen: "64"
{% endif %}
  registries:
    config:
      zot.merry.home.arpa:
        tls:
          insecureSkipVerify: true
  features:
    diskQuotaSupport: true
    kubePrism:
      enabled: true
      port: 7445
  nodeLabels:
{% if cp %}
    node.kubernetes.io/exclude-from-external-load-balancers: ""
{% else %}
{#
  "config" tells Longhorn to read the default-disks-config annotation below instead of
  auto-creating a default disk at /var/lib/longhorn.
#}
    node.longhorn.io/create-default-disk: config
  nodeAnnotations:
    node.longhorn.io/default-disks-config: '[{"name":"longhorn-data","path":"/var/mnt/longhorn","allowScheduling":true,"storageReserved":0,"tags":[]}]'
{% endif %}
cluster:
  id: {{ cluster.id }}
  secret: {{ cluster.secret }}
  controlPlane:
    endpoint: https://10.0.20.10:6443
  clusterName: going-merry
  token: {{ secrets.bootstraptoken }}
  ca:
    crt: {{ certs.k8s.crt }}
    key: {{ certs.k8s.key if cp else '""' }}
{% if cp %}
  aggregatorCA:
    crt: {{ certs.k8saggregator.crt }}
    key: {{ certs.k8saggregator.key }}
  serviceAccount:
    key: {{ certs.k8sserviceaccount.key }}
  etcd:
    ca:
      crt: {{ certs.etcd.crt }}
      key: {{ certs.etcd.key }}
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
{#
  Applying a config only *creates* extraManifests resources; it never updates one that already
  exists. Anything that needs to be upgradable belongs in Flux instead (metrics-server moved
  there). Keep this list to what has to exist before Flux does: the CSR approver that signs the
  kubelet serving certificates enabled by rotate-server-certificates above. A bump here is
  therefore inert until applied by hand, and check the image first — upstream has shipped that
  manifest pointing at a floating tag. `upgrade-k8s` is the exception: it reconciles this list,
  so it reverts a hand-applied version back to the URL the node config holds, and it deletes
  what has left the list — that is what removed metrics-server after the move to Flux, without
  Flux noticing its own objects were gone.
#}
  extraManifests:
    - https://raw.githubusercontent.com/alex1989hu/kubelet-serving-cert-approver/v0.12.1/deploy/standalone-install.yaml
{% endif %}
---
apiVersion: v1alpha1
kind: DiscoveryServiceConfig
name: default
endpoint: https://discovery.talos.dev/
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
  - address: 1.1.1.1
  - address: 9.9.9.9
hostDNS:
  enabled: true
  forwardKubeDNSToHost: false
---
apiVersion: v1alpha1
kind: FilesystemTrimConfig
interval: 168h0m0s
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: 'off'
hostname: {{ this.hostname }}
---
apiVersion: v1alpha1
kind: KubeNetworkConfig
dnsDomain: cluster.local
podSubnets:
  - 10.244.0.0/16
serviceSubnets:
  - 10.96.0.0/12
{% if cp %}
---
apiVersion: v1alpha1
kind: KubeAdmissionControlConfig
name: PodSecurity
configuration:
  apiVersion: pod-security.admission.config.k8s.io/v1beta1
  defaults:
    audit: restricted
    audit-version: latest
    enforce: baseline
    enforce-version: latest
    warn: restricted
    warn-version: latest
  exemptions:
    namespaces:
      - kube-system
      - longhorn-system
      - monitoring
    runtimeClasses: []
    usernames: []
  kind: PodSecurityConfiguration
---
apiVersion: v1alpha1
kind: KubeAuditPolicyConfig
configuration:
  apiVersion: audit.k8s.io/v1
  kind: Policy
  rules:
    - level: Metadata
---
apiVersion: v1alpha1
kind: KubeAuthenticationConfig
configuration:
  anonymous:
    conditions:
      - path: /livez
      - path: /readyz
      - path: /healthz
    enabled: true
  jwt: []
---
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: node
type: Node
---
apiVersion: v1alpha1
kind: KubeAuthorizerConfig
name: rbac
type: RBAC
---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
image: registry.k8s.io/kube-apiserver:{{ kubernetesVersion }}
certExtraSANs:
  - 10.0.20.10
{# Talos's default let every reboot's dead pods pile up. A count, not an age: it caps how many
   terminated pods are kept and collects the oldest, it does not empty them. #}
---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
image: registry.k8s.io/kube-controller-manager:{{ kubernetesVersion }}
extraArgs:
  terminated-pod-gc-threshold: "30"
---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
image: registry.k8s.io/kube-scheduler:{{ kubernetesVersion }}
config: {}
---
apiVersion: v1alpha1
kind: KubeProxyConfig
enabled: false
image: registry.k8s.io/kube-proxy:{{ kubernetesVersion }}
config: {}
{% endif %}
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: enp1s0
{% if cp %}
---
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: 10.0.20.10
link: enp1s0
{#
  The encryption key keeps the name `key2` and the identity provider that the v1alpha1 field it
  replaced rendered. Talos's own KubeEtcdEncryptionConfig names it `key1` and drops identity, but
  the name is part of the prefix written in front of every encrypted Secret in etcd: with it,
  all three apiservers lost readiness and Secrets became unreadable until the old config was
  re-applied. Keep this identical to what the cluster was built with.
#}
---
apiVersion: v1alpha1
kind: KubeEtcdEncryptionConfig
config:
  resources:
    - providers:
        - secretbox:
            keys:
              - name: key2
                secret: {{ secrets.secretboxencryptionsecret }}
        - identity: {}
      resources:
        - secrets
{% else %}
---
apiVersion: v1alpha1
kind: VolumeConfig
name: EPHEMERAL
provisioning:
  maxSize: 100GiB
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: longhorn
provisioning:
  diskSelector:
    match: system_disk
  grow: true
  minSize: 200GiB
{% endif %}
