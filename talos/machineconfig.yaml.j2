{#
  Machine config of every node. scripts/talos-render.sh renders it with the node's entry from
  nodes.yaml and the secrets bundle, decrypted into a pipe and never written to disk.

  Nothing here is generated. talhelper built it from the Talos library it embedded, and a
  generator's library decides the shape of the config as much as talosVersion does: a newer
  one emits new documents on its own, and that is how KubeEtcdEncryptionConfig arrived with
  the apiserver outage. `talosctl gen config` output is still worth reading as the reference
  for what Talos now expects, but a new document enters this file by hand, in a diff.
#}
{% set this = (nodes | selectattr("hostname", "eq", node) | list)[0] %}
{% set cp = this.controlPlane %}
version: v1alpha1
debug: false
persist: true
machine:
  type: {{ "controlplane" if cp else "worker" }}
  token: {{ trustdinfo.token }}
  ca:
    crt: {{ certs.os.crt }}
    key: {{ certs.os.key if cp else '""' }}
  certSANs:
    - 10.0.20.10
    - 10.0.20.11
    - 10.0.20.12
    - 10.0.20.13
    - 10.0.20.14
    - 10.0.20.15
    - 10.0.20.16
  kubelet:
    image: ghcr.io/siderolabs/kubelet:{{ kubernetesVersion }}
    extraArgs:
      rotate-server-certificates: "true"
    extraMounts:
      - destination: /var/lib/longhorn
        type: bind
        source: /var/lib/longhorn
        options:
          - bind
          - rshared
          - rw
{% if not cp %}
      - destination: /var/mnt/longhorn
        type: bind
        source: /var/mnt/longhorn
        options:
          - bind
          - rshared
          - rw
{% endif %}
    extraConfig:
      serializeImagePulls: false
    defaultRuntimeSeccompProfileEnabled: true
    disableManifestsDirectory: true
  features:
    diskQuotaSupport: true
cluster:
  token: {{ secrets.bootstraptoken }}
{% if cp %}
  etcd:
    ca:
      crt: {{ certs.etcd.crt }}
      key: {{ certs.etcd.key }}
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
{% endif %}
---
apiVersion: v1alpha1
kind: DiscoveryServiceConfig
name: default
endpoint: https://discovery.talos.dev/
{#
  The discovery identity keeps the values the cluster was built with, straight from the
  secrets bundle. Talos 1.14 changed how a new bundle encodes the ID; these two are plain
  base64 of 32 bytes either way, and any other value would make the nodes a new cluster to
  the discovery service.
#}
---
apiVersion: v1alpha1
kind: DiscoveryIdentityConfig
clusterID: {{ cluster.id }}
clusterSecret: {{ cluster.secret }}
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
  - address: 1.1.1.1
  - address: 9.9.9.9
hostDNS:
  enabled: true
  forwardKubeDNSToHost: false
---
apiVersion: v1alpha1
kind: FilesystemTrimConfig
interval: 168h0m0s
{#
  Spegel serves image layers to the other nodes from each node's containerd store, and
  containerd deletes the compressed layers once they are unpacked unless told not to.
  Changing this document restarts containerd without a reboot. Running containers are not
  touched, but Spegel exits when containerd's event stream closes, and the mirror files it
  wrote are gone: talos:apply recreates its pod (see spegel:remirror).
#}
---
apiVersion: v1alpha1
kind: CRICustomizationConfig
name: spegel
content: |
  [plugins."io.containerd.cri.v1.images"]
    discard_unpacked_layers = false
{#
  Trust the internal CA at the node level so containerd can verify zot over TLS. A TLS setting
  for zot in the registry config would not reach containerd: Spegel moves every host config it
  does not mirror into /etc/cri/conf.d/hosts/_backup/ when it starts, zot among them. Without
  this, an image that is not already cached on the node fails to pull with
  `x509: certificate signed by unknown authority`.
#}
---
